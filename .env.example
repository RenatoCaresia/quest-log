# Copie este arquivo para .env.local e preencha os valores.
# Nunca faça commit do .env.local: ele guarda segredos.

# Supabase (botão "Connect" do projeto, no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# TMDB, filmes e séries (API Read Access Token, na conta de desenvolvedor)
TMDB_READ_ACCESS_TOKEN=

# IGDB via Twitch, jogos (app registrado no Twitch Developer Portal)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Open Library, livros (não pede chave; o e-mail vai no cabeçalho User-Agent)
OPEN_LIBRARY_CONTACT_EMAIL=

# Sentry, monitoramento de erros
NEXT_PUBLIC_SENTRY_DSN=
